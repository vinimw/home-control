{
  "name": "home-control",
  "version": "0.1.0",
  "private": true,
  "description": "Local home control hub for Samsung TV, Echo Show 8 and Spotify via Home Assistant",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm --filter @home-control/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @home-control/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist .next *.tsbuildinfo",
    "ha:check": "bash scripts/check-home-assistant.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "env:init": "test -f .env || cp .env.example .env",
    "env:check": "pnpm --filter @home-control/api env:check",
    "dev:doctor": "bash scripts/doctor.sh",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "device:probe": "node scripts/probe-device.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
