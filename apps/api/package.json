{
  "name": "@home-control/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "env:check": "tsx --env-file-if-exists=../../.env src/check-env.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@home-control/shared": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}
