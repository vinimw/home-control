# Copy to .env (never commit it): `pnpm env:init`
# Validated at startup by apps/api (see apps/api/src/config.ts). Errors name the variable.

# --- Docker Compose: host ports published on your Mac ---
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- API ---
# Bind address and port (inside Docker these are fixed by compose.yaml).
API_HOST=0.0.0.0
API_PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# SQLite directory. Local default is apps/api/data (git-ignored); Docker uses the api-data volume at /data.
# DATA_DIR=./data

# --- Web ---
# Server-side URL of the API. Docker sets http://api:3001 itself.
# API_INTERNAL_URL=http://localhost:3001

# --- Home Assistant (runs separately in a macOS VM, see docs/HOME_ASSISTANT.md) ---
# API only; never exposed to the web app. Set BOTH or NEITHER.
# Use the VM IP address, not homeassistant.local (mDNS does not resolve inside containers).
# HOME_ASSISTANT_URL=http://192.168.1.50:8123
# HOME_ASSISTANT_TOKEN=
