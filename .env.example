# Copy to .env (never commit it): `pnpm env:init`
# Validated at startup by apps/api (see apps/api/src/config.ts). Errors name the variable.

# --- Docker Compose: host ports published on your Mac ---
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- API ---
# Bind address and port (inside Docker these are fixed by compose.yaml).
API_HOST=0.0.0.0
API_PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# SQLite directory. Local default is apps/api/data (git-ignored); Docker uses the api-data volume at /data.
# DATA_DIR=./data

# --- Web ---
# Server-side URL of the API. Docker sets http://api:3001 itself.
# API_INTERNAL_URL=http://localhost:3001

# --- Home Assistant (runs separately in a macOS VM, see docs/HOME_ASSISTANT.md) ---
# API only; never exposed to the web app. Set BOTH or NEITHER.
# Use the VM IP address, not homeassistant.local (mDNS does not resolve inside containers).
# HOME_ASSISTANT_URL=http://192.168.1.50:8123
# HOME_ASSISTANT_TOKEN=
# REST request timeout in ms (1000-60000, default 10000).
# HOME_ASSISTANT_TIMEOUT_MS=10000
# Full device registry resync interval in ms (5000-3600000, default 300000 = 5 min).
# DEVICE_REFRESH_INTERVAL_MS=300000

# --- Security (see docs/SECURITY.md) ---
# Login is mandatory. On the first run the API logs a one-time setup code (`docker compose logs api`);
# open the web app and use it to create the password. Forgot it? Run
# `docker compose exec api node dist/auth-cli.js reset-password` and restart the API.
# Development only: turns the login off. Refused when NODE_ENV=production (always the case in Docker).
# AUTH_ENABLED=true
# Session cookie `Secure` flag: auto (when the request came over HTTPS), true or false.
# AUTH_COOKIE_SECURE=auto
# Host interfaces Docker publishes the ports on. The API stays on loopback; the web app is on the LAN.
# API_BIND_ADDRESS=127.0.0.1
# WEB_BIND_ADDRESS=0.0.0.0

# --- Spotify (see docs/SPOTIFY.md) ---
# Create an app at https://developer.spotify.com/dashboard. PKCE: there is no client secret to set.
# Set BOTH or NEITHER. The redirect URI must be https or http://127.0.0.1:<web port>/api/spotify/callback
# (Spotify does not accept "localhost") and match the dashboard character for character.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Key that encrypts the stored Spotify tokens (openssl rand -base64 32). Unset: a random key file is created
# once in the data directory.
# APP_SECRET_KEY=

# --- Device actions ---
# POST /devices/:id/actions controls real devices. Unset means "on when authentication is on".
# DEVICE_ACTIONS_ENABLED=true

# --- Samsung TV remote (see docs/SAMSUNG_TV.md) ---
# Apps the TV can launch, as JSON {"name":"id"}. Ids depend on TV model and region; the default is the
# four verified on the household's Q80A (Netflix, Prime Video, Disney+, YouTube). An app is offered only when
# the media player also lists it as a source.
# TV_APPS={"Netflix":"3201907018807","Prime Video":"3201910019365","Disney+":"3201901017640","YouTube":"111299001912"}
# Pairs "media_player.x=remote.y" when the remote and the media player are not on the same Home Assistant
# device (for example the built-in Samsung remote with the SamsungTV Smart media player). Comma-separated.
# DEVICE_LINKS=media_player.sala_de_estar_samsung_tv_smart=remote.sala_de_estar_samsung_tv
