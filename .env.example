# Copy to .env (ignored by Git). Never commit real credentials.

# Host ports published by Docker Compose
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# Home Assistant (runs separately in a macOS VM, see docs/HOME_ASSISTANT.md). Used by the API only.
# Use the VM IP address, not homeassistant.local (mDNS does not resolve inside containers).
# HOME_ASSISTANT_URL=http://192.168.1.50:8123
# HOME_ASSISTANT_TOKEN=
